; Engine configuration file.
; PROJECT STRIKE - 5v5 战术竞技第一人称射击游戏
; 引擎: Godot 4.4.1 stable (Forward Plus) + GodotSteam v4.16 (Steamworks 1.62)

config_version=5

[application]

config/name="PROJECT STRIKE"
config/description="Original 5v5 tactical competitive FPS. All assets procedural / original."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon/game.ico"
config/quit_on_go_back=false

[autoload]

GameConfig="*res://scripts/Data/GameConfig.gd"
EventBus="*res://scripts/Core/EventBus.gd"
AudioForge="*res://scripts/Audio/AudioForge.gd"
WeaponDatabase="*res://scripts/Data/WeaponDatabase.gd"
SkinDatabase="*res://scripts/Shop/SkinDatabase.gd"
InventoryService="*res://scripts/Shop/InventoryService.gd"
CurrencyManager="*res://scripts/Shop/CurrencyManager.gd"
ShopManager="*res://scripts/Shop/ShopManager.gd"
GameManager="*res://scripts/Core/GameManager.gd"
RankSystem="*res://scripts/Core/RankSystem.gd"
ReplaySystem="*res://scripts/Core/ReplaySystem.gd"
SteamManager="*res://scripts/Core/SteamManager.gd"
NetworkManager="*res://scripts/Core/NetworkManager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

common/physics_ticks_per_second=128
common/physics_interpolation=false
3d/default_gravity=18.0
3d/default_linear_damp=0.0
3d/default_angular_damp=0.1

[layer_names]

3d_physics/layer_1="World"
3d_physics/layer_2="PlayerBody"
3d_physics/layer_3="Hitbox"
3d_physics/layer_4="Grenade"
3d_physics/layer_5="Debris"
3d_physics/layer_6="Smoke"

[rendering]

; ══════════════════════════════════════════════════════════════════════
; 画面质量基线（A1 画质重做, 2026-09）
; 这里只放「渲染管线初始化时读取一次」的默认值 —— 也就是切画质档位
; 无法在运行期更改、必须重启才生效的那些。运行期真正可切的部分
; 全部由 scripts/Core/GraphicsQuality.gd 在 Viewport / Environment 上设置。
;
; 历史值对照（改造前 → 改造后）:
;   msaa_3d           1(2x)  → 2(4x)      抗锯齿从"聊胜于无"到真正有效
;   screen_space_aa   1(FXAA)→ 0(关)      改用 TAA, 避免 FXAA 二次糊化
;   use_taa           false  → true       本引擎最有效的 AA
;   aniso             8(非法) → 3(8x)     原值超出枚举(0..4), 实际从未生效
;   dir_soft_filter   2      → 3(Ultra)   软阴影滤波提一档
;   pos_shadow_filter 未设置 → 3(Ultra)   位置光阴影滤波对齐
;   occlusion 剔除    false  → true       原实现只建 BVH 却从不启用(纯浪费)
;   reflection_size   256    → 512        反射探针贴图分辨率
;   ggx_samples       32     → 64         天空反射质量
;   sdfgi 收敛        5      → 3          动态 GI 收敛更快(更少闪烁)
;   sdfgi 射线        1      → 2          每探针射线数, GI 噪点更少
;
; 试过但**回退**的项（记录以免后人重复踩坑, 见 outputs/A1_visual_upgrade_notes.md）:
;   dir_shadow 8192     → 回退 4096   阴影图 8192 在 4 级联下每级 4096, 视觉
;                                     增益有限, 但占 134MB 显存并拖累软阴影滤波
;   ssao/ssil half=false → 回退 true  全分辨率接触阴影是 4 倍像素开销
;   材质 16x 各向异性    → 回退无各向异性  三平面已 3 次采样, 再叠加各向异性
;                                     会把掠射角大平面的采样成本放大一个数量级
;   SDFGI 开在"高"档     → 改为仅"超高/电影"  实测 SDFGI 约 11ms, 占满
;                                     141 FPS(7.09ms) 的全部预算, 不能进默认档
; ══════════════════════════════════════════════════════════════════════

; ---- 渲染后端 ----
renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
textures/vram_compression/import_etc2_astc=false

; ---- 抗锯齿: TAA 为主; FXAA 仅在关闭 TAA 的档位(低/竞技兜底)由代码打开 ----
anti_aliasing/quality/msaa_3d=2
anti_aliasing/quality/screen_space_aa=0
anti_aliasing/quality/use_taa=true
anti_aliasing/quality/use_debanding=true
anti_aliasing/screen_space_roughness_limiter/enabled=true
anti_aliasing/screen_space_roughness_limiter/amount=0.25
anti_aliasing/screen_space_roughness_limiter/limit=0.15

; ---- 阴影 ----
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/positional_shadow/atlas_size=4096
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/16_bits=true

; ---- 环境: SSAO / SSIL ----
; half_size 保持 true。改成全分辨率视觉收益有限(接触阴影本来就模糊),
; 但按像素看是 4 倍开销, 在 141 FPS 的预算里不值得。
environment/ssao/half_size=true
environment/ssao/quality=2
environment/ssao/adaptive_target=0.5
environment/ssil/half_size=true
environment/ssil/quality=2
environment/ssil/blur_passes=4
environment/screen_space_reflection/roughness_quality=2

; ---- 全局光照: SDFGI 动态全局光照(实时软 GI, 本引擎最接近光追 GI 的能力) ----
global_illumination/sdfgi/frames_to_converge=3
global_illumination/sdfgi/frames_to_update_lights=2
global_illumination/sdfgi/probe_ray_count=2

; ---- 反射: 天空 GGX 采样 + 反射探针图集 ----
reflections/sky_reflections/ggx_samples=64
reflections/sky_reflections/roughness_layers=8
reflections/sky_reflections/fast_filter_high_quality=true
reflections/reflection_atlas/reflection_size=512
reflections/reflection_atlas/reflection_count=32

; ---- 采样与过滤 ----
textures/default_filters/anisotropic_filtering_level=3
textures/canvas_textures/default_texture_filter=0

; ---- 遮挡剔除: 启用 BVH 剔除(建了 BVH 就必须启用, 否则白建) ----
occlusion_culling/use_occlusion_culling=true
occlusion_culling/bvh_build_quality=3
occlusion_culling/jitter_projection=true
world/occlusion_culling/build_quality=3

; ---- 其它 ----
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)

[debug]

gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0

[input]

ui_accept={
"deadzone": 0.5,
"events": []
}
